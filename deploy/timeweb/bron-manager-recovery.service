[Unit]
Description=Deliver Bron Franchise manager recovery email
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=true
User=bron-recovery
BindReadOnlyPaths=/opt/bron/manager-recovery:/run/bron-recovery-app
BindReadOnlyPaths=/opt/bron/node-v22.23.5-linux-x64:/run/bron-recovery-node
BindReadOnlyPaths=/etc/bron-franchise/google-finance-db-ca.crt:/run/bron-recovery-db-ca.crt
WorkingDirectory=/run/bron-recovery-app
EnvironmentFile=/etc/bron-franchise/manager-recovery.env
UnsetEnvironment=NODE_DEBUG NODE_DEBUG_NATIVE NODE_OPTIONS
ExecStart=/usr/bin/env BRON_DB_CA_FILE=/run/bron-recovery-db-ca.crt /run/bron-recovery-node/bin/node scripts/manager-recovery-delivery.mjs --run
TimeoutStartSec=80s
TimeoutStopSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
UMask=0077
