# Production DNS must point to the verified Russian server before TLS issuance.
app.bronservis.ru {
	root * /srv/app
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cache-Control "no-cache"
	}
	@fresh path / /index.html /app-version.json /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-store"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
}

bronservis.ru {
	root * /srv/landing
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "no-cache"
	}
	file_server
}

api.bronservis.ru {
	@health {
		path /.well-known/bron-health.json
		method GET HEAD
	}
	handle @health {
		route {
			root * /srv/status
			rewrite * /bron-health.json
			header {
				Cache-Control no-store
				Content-Type application/json
			}
			file_server {
				pass_thru
			}
			respond 503
		}
	}
	@clientAPI path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @clientAPI {
		reverse_proxy api-gw:8000
	}
	# Studio, database administration, Edge Function deployment and the gateway
	# dashboard are never proxied to the Internet. Use an SSH tunnel if needed.
	handle {
		respond 404
	}
}
