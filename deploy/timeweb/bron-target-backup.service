[Unit]
Description=Encrypted Bron target backup with independent S3 read-back
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/bron/backup/target-backup.py --backup
ExecStartPost=/usr/bin/python3 /opt/bron/backup/target-backup.py --check-age
# Failure transport is intentionally separate from the backup and its credentials.
ExecStopPost=/usr/bin/python3 /opt/bron/backup/target-backup.py --alert-on-failure
TimeoutStartSec=50min
TimeoutStopSec=45s
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/bron-secrets /var/backups/bron-franchise

