[Unit]
Description=Bron Franchise MoySklad primary documents staging sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bron-documents
WorkingDirectory=/opt/bron/document-sync
EnvironmentFile=/etc/bron-franchise/moysklad-documents.env
Environment=PATH=/opt/bron/node-v22.23.5-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/sync-moysklad-documents.mjs --recent
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
