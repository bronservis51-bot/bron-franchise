[Unit]
Description=Bron Franchise MoySklad supply report sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bron-supply
WorkingDirectory=/opt/bron/purchase-sync
EnvironmentFile=/etc/bron-franchise/moysklad-sync.env
Environment=PATH=/opt/bron/node-v22.23.5-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/sync-moysklad.mjs --recent
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
