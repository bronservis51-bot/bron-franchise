[Unit]
Description=Export Bron Franchise finance to private Google workbooks
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bron-report
WorkingDirectory=/opt/bron/google-finance
EnvironmentFile=/etc/bron-franchise/google-finance.env
Environment=PATH=/opt/bron/node-v22.23.5-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/sync-google-finance.mjs --publish
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
