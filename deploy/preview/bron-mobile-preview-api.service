[Unit]
Description=Bron Service mobile preview synthetic API
After=network.target

[Service]
User=bron-preview
Group=bron-preview
Environment=PORT=54982
Environment=BRON_STAGING_REQUIRED=1
EnvironmentFile=/etc/bron-mobile-preview/api.env
WorkingDirectory=/opt/bron-mobile-preview/current/backend
ExecStart=/opt/bron-mobile-preview/runtime/node scripts/local-backend.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=/opt/bron
ReadWritePaths=/var/lib/bron-mobile-preview
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
