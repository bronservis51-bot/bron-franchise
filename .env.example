# Пример конфигурации без секретов. Скопируйте в .env.local и заполните.
# URL проекта Supabase и publishable (или legacy anon) ключ — публичные значения, безопасны в браузере при включённом RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Подкаталог GitHub Pages: /<имя-репозитория>/ ; для локального запуска — /
VITE_BASE_PATH=/
# Метка окружения в интерфейсе: demo | staging | production
VITE_APP_ENV=production

# Только для scripts/seed-users.mjs на компьютере администратора. НИКОГДА не в VITE_* и не в репозитории.
# SUPABASE_SECRET_KEY=sb_secret_...
# Прямое подключение к базе для npm run db:apply (Session pooler). Содержит пароль — секрет.
# DATABASE_URL=postgresql://postgres.<project>:<пароль>@<host>:5432/postgres

# Только на доверенном сервере синхронизации МойСклад, права только чтения:
# MOYSKLAD_READ_TOKEN=...
# Для проверки переноса (только чтение, не VITE_*):
# SOURCE_DATABASE_URL=...
# TARGET_DATABASE_URL=...
